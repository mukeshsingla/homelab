[wsl2]
# RESOURCE MANAGEMENT
## Cap RAM and CPU so your homelab doesn't freeze your Windows host
memory=16GB
processors=16
swap=2GB
swapFile=C:\\temp\\wsl-swap.vhdx

# PERFORMANCE & DISK SETTINGS
## Automatically releases unused RAM back to Windows
autoMemoryReclaim=gradual
## Speeds up container storage I/O performance
vmIdleTimeout=60000